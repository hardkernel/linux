CONFIG_LOCALVERSION="-rockchip-odroid-arm64"
CONFIG_ARCH_ROCKCHIP_ODROIDM1=y
# CONFIG_TOUCHSCREEN_GT1X is not set
# CONFIG_TOUCHSCREEN_GT9XX is not set
CONFIG_ROCKCHIP_THERMAL=y
# CONFIG_MFD_RK806 is not set
# CONFIG_MFD_RK806_I2C is not set
# CONFIG_MFD_RK806_SPI is not set
# CONFIG_REGULATOR_RK860X is not set
CONFIG_VIDEO_IMX219=y
CONFIG_VIDEO_OV5647=m
# CONFIG_ROCKCHIP_DW_DP is not set
# CONFIG_ROCKCHIP_DW_HDCP2 is not set
# CONFIG_ROCKCHIP_DP_MST_AUX_CLIENT is not set
CONFIG_DRM_PANEL_ILITEK_ILI9881C=y
CONFIG_TINYDRM_ILI9341=m
# CONFIG_MALI_MIDGARD is not set
CONFIG_MALI_BIFROST=y
CONFIG_MALI_PLATFORM_NAME="rk"
# CONFIG_MALI_BIFROST_GATOR_SUPPORT is not set
CONFIG_MALI_BIFROST_EXPERT=y
CONFIG_MALI_BIFROST_DEBUG=y
CONFIG_PHY_ROCKCHIP_MIPI_RX=m
CONFIG_RK_FLASH=y
CONFIG_RK_SFC_NOR=y
CONFIG_RK_SFC_NOR_MTD=y
CONFIG_ROCKCHIP_RKNPU=m
CONFIG_ROCKCHIP_RKNPU_PROC_FS=y
CONFIG_ROCKCHIP_RGA2=y
# CONFIG_ROCKCHIP_MULTI_RGA is not set
CONFIG_DRM=y
CONFIG_DRM_PANEL_MIPI_DBI=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_MTD=y

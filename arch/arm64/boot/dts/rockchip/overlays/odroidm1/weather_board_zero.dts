/dts-v1/;
/plugin/;

/ {
	fragment@0 {
		// i2c3 aliased with i2c0.
		// This activates i2c3 but it will be named as i2c0 on the userspace.
		target = <&i2c3>;

		__overlay__ {
			status = "okay";
			#address-cells = <1>;
			#size-cells = <0>;

			shtc1: shtc1@70 {
				status = "okay";
				compatible = "sensirion,shtc1";
				reg = <0x70>;
			};
		};
	};
};
